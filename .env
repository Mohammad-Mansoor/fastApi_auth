# =========================
# APPLICATION
# =========================
APP_NAME=AdvancedAuthSystem
APP_ENV=development
DEBUG=True
PORT=8000

# =========================
# DATABASE (POSTGRESQL)
# =========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fastapi_auth_db
DB_USER=postgres
DB_PASSWORD=admin123

DATABASE_URL=postgresql+asyncpg://admin:admin123@localhost:5432/fastapi_auth_db

# =========================
# REDIS
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

REDIS_URL=redis://localhost:6379/0

# =========================
# RABBITMQ
# =========================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# =========================
# JWT AUTH
# =========================
JWT_SECRET_KEY=super-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =========================
# SECURITY
# =========================
BCRYPT_ROUNDS=12

# =========================
# FILE STORAGE
# =========================
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# =========================
# MONITORING (PROMETHEUS)
# =========================
PROMETHEUS_ENABLED=True

# =========================
# WEBSOCKETS
# =========================
WEBSOCKET_PING_INTERVAL=25
WEBSOCKET_PING_TIMEOUT=10